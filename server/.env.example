# Beam server environment. Copy to .env; values in the real environment win over .env.
# The server refuses to start in production (NODE_ENV=production) with missing keys,
# a weak AGENT_TOKEN or WORLD_MODE=staging. Keys are never logged.

# Claude. Without a key every request uses the regex fallback parser (required in production).
ANTHROPIC_API_KEY=
# Fast default for the overlay; switch to claude-sonnet-5-5 if extraction quality is poor.
ANTHROPIC_MODEL=claude-haiku-5-5
# Shared bearer token (also baked into the app as EXPO_PUBLIC_AGENT_TOKEN). Production needs 32+ random characters.
AGENT_TOKEN=change-me
PORT=8787

# Payment network: arc (default). Must match the app's EXPO_PUBLIC_NETWORK.
BEAM_NETWORK=arc
ARC_RPC_URL=
# Deployed BeamPay contract on BEAM_NETWORK (required).
BEAMPAY_ADDRESS=

# ENS reads: mainnet (default) or sepolia.
ENS_CHAIN=mainnet
# Leave empty for the keyless PublicNode RPC; use a keyed provider in production.
ENS_RPC_URL=

# World ID approvals (IDKit, World ID 4.0): off (default), staging (World ID simulator, development only)
# or production (World App). staging and production need the four values below.
WORLD_MODE=off
# From the World developer portal: app, relying party and its signing key (secret; signs every proof request).
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
# Signs BeamPay approvals (EIP-712). Holds no funds.
APPROVER_PRIVATE_KEY=
# 32 random bytes as 0x hex (openssl rand -hex 32, then prefix 0x). Salts the onchain human binding.
HUMAN_HASH_SALT=
# Where linked wallets' World ID sessions are kept (default data/world-sessions.json). Back it up.
WORLD_SESSIONS_PATH=

# Beam handles (see src/handles/config.ts). All three or none; none disables claims (503).
ENS_PARENT_NAME=
ENS_REGISTRAR_PRIVATE_KEY=
ENS_HANDLE_REGISTRY=
# Optional: written to each handle's url text record, and where the per-human handle map is stored.
BEAM_REPO_URL=
HANDLES_STORE_PATH=

# MCP server only (npm run mcp).
MCP_WALLET_ADDRESS=
# Static daily limit in the network's token for MCP-prepared payments.
MCP_DAILY_LIMIT=100
