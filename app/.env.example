# Privy dashboard → Settings → Clients (mobile). Client IDs start with "client-".
# Add "com.bubbleagent.app" to the client's allowed app identifiers and "bubbleagent" to its URL schemes.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=
# Agent server URL (your ngrok domain or a deployed host). No trailing slash.
EXPO_PUBLIC_AGENT_URL=https://your-domain.ngrok-free.dev
# Must equal AGENT_TOKEN in server/.env. Bundled into the APK, so treat it as demo-grade auth.
EXPO_PUBLIC_AGENT_TOKEN=change-me

# Network this build pays on: arc (default). Must match BEAM_NETWORK on the server.
EXPO_PUBLIC_NETWORK=arc
# BeamPay deployment on that network. Empty blocks payments with a setup banner.
EXPO_PUBLIC_BEAMPAY_ADDRESS=
# Optional: override the network's public RPC (defaults come from src/network.ts).
EXPO_PUBLIC_RPC_URL=

# ENS resolution chain: mainnet (default) or sepolia. Must match the server's ENS chain.
EXPO_PUBLIC_ENS_CHAIN=mainnet
# Ethereum RPC for ENS reads, ideally with a provider key. Empty uses viem's public default (rate limited).
# The RPC provider sees which names you look up.
EXPO_PUBLIC_ENS_RPC_URL=
